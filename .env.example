# LXD MCP Server Configuration

# Server port
PORT=3000

# LXD Unix socket path (default is for snap-installed LXD)
LXD_SOCKET_PATH=/var/snap/lxd/common/lxd/unix.socket

# Log level: debug, info, error
LOG_LEVEL=info

# Access token for bearer token authentication (optional but recommended)
# Set this to protect /mcp endpoints with Bearer token authentication
# Clients must include: Authorization: Bearer <token>
# ACCESS_TOKEN=your-secret-token-here
