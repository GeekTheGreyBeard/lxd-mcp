{
  "name": "lxd-mcp",
  "version": "1.0.0",
  "description": "MCP server for LXD container management",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "lxd",
    "container",
    "mcp-server",
    "llm"
  ],
  "author": "Hans Ronald Fischer",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgeseek/lxd-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/edgeseek/lxd-mcp/issues"
  },
  "bin": {
    "lxd-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.14.0",
    "express": "5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.3.6",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.16",
    "vite": "^6.0.0"
  }
}
